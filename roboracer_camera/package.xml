<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roboracer_camera</name>
  <version>0.1.0</version>
  <description>
    ZED depth -> synthetic LaserScan of standing (above-LiDAR-slice) obstacles,
    published as a second observation source for the Nav2 costmap. Self-contained:
    adding this package changes nothing in roboracer_estimation / roboracer_control
    except one additive observation_source block in nav2_params_real.yaml.
  </description>
  <maintainer email="mohammadsadeghshoushtari@gmail.com">Shiran RoboRacer</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>python3-sklearn</exec_depend>
  <!-- person_detector also needs ultralytics (pip) + a YOLOv8 model on hardware. -->

  <!-- ZED driver is launched separately; not a hard build/exec dep of this pkg. -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
