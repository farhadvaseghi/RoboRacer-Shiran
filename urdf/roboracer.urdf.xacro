<?xml version="1.0"?>
<robot name="roboracer" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================================================================
       RoboRacer — URDF for Gazebo Classic simulation
       Car dimensions (from physical measurements):
         Total length : 520 mm   Wheelbase  : 324 mm
         Track width  : 232 mm   Wheel dia  : 100 mm
         Front overhang: 101 mm  Rear overhang: 95 mm
       base_link: rear axle, ground plane, x=forward, y=left, z=up (REP-105)
       Geometric centre is at x=+0.165 m from base_link.
  =================================================================== -->

  <!-- ── Materials ──────────────────────────────────────────────────── -->
  <material name="white">  <color rgba="0.9 0.9 0.9 1.0"/> </material>
  <material name="black">  <color rgba="0.1 0.1 0.1 1.0"/> </material>
  <material name="blue">   <color rgba="0.0 0.4 0.9 1.0"/> </material>
  <material name="grey">   <color rgba="0.5 0.5 0.5 1.0"/> </material>

  <!-- ── Inertia macros ─────────────────────────────────────────────── -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12}" iyz="0"
               izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+h*h)/12}" iyz="0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <!-- ── Chassis (base_link = rear axle) ──────────────────────────── -->
  <!-- Chassis box is 520 mm long. Geometric centre is 165 mm ahead of rear axle,
       so the visual is offset +0.165 m in x from base_link. -->
  <link name="base_link">
    <visual>
      <origin xyz="0.165 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.520 0.232 0.08"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0.165 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.520 0.232 0.08"/></geometry>
    </collision>
    <xacro:box_inertia m="3.0" x="0.520" y="0.232" z="0.08"/>
  </link>

  <!-- ── Wheel macro ────────────────────────────────────────────────── -->
  <!--  radius=0.05 m, width=0.025 m, rotated 90° so axis is along Y   -->
  <xacro:macro name="wheel" params="name x y">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="0.05" length="0.025"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="0.05" length="0.025"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="0.15" r="0.05" h="0.025"/>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}"/>
      <origin xyz="${x} ${y} 0.05" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>
  </xacro:macro>

  <!-- Rear drive wheels  (x = 0.000 m — rear axle IS base_link) -->
  <xacro:wheel name="rear_left_wheel"  x="0.000"  y=" 0.116"/>
  <xacro:wheel name="rear_right_wheel" x="0.000"  y="-0.116"/>

  <!-- Front caster wheels (x = +0.324 m — wheelbase) -->
  <xacro:wheel name="front_left_wheel"  x=" 0.324"  y=" 0.116"/>
  <xacro:wheel name="front_right_wheel" x=" 0.324"  y="-0.116"/>

  <!-- ── Axle frames (for Estimation/Control teammates) ─────────────── -->
  <link name="rear_axle"/>
  <joint name="rear_axle_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="rear_axle"/>
    <origin xyz="0.000 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <link name="front_axle"/>
  <joint name="front_axle_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="front_axle"/>
    <origin xyz="0.324 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <!-- ── LiDAR (HOKUYO UST-10LX) ───────────────────────────────────── -->
  <link name="laser">
    <visual>
      <geometry><cylinder radius="0.025" length="0.04"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.025" length="0.04"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="0.1" r="0.025" h="0.04"/>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="laser"/>
    <origin xyz="0.270 0.0 0.110" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo ray sensor — UST-10LX specs: 1081 rays, 270° FOV, 40 Hz -->
  <gazebo reference="laser">
    <sensor name="hokuyo_lidar" type="ray">
      <always_on>true</always_on>
      <update_rate>40</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>1081</samples>
            <resolution>1</resolution>
            <min_angle>-2.35619449</min_angle>
            <max_angle> 2.35619449</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.06</min>
          <max>8.0</max>
          <resolution>0.001</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ── ZED 2i Camera ──────────────────────────────────────────────── -->
  <link name="zed_camera_link">
    <visual>
      <geometry><box size="0.033 0.175 0.030"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><box size="0.033 0.175 0.030"/></geometry>
    </collision>
    <xacro:box_inertia m="0.17" x="0.033" y="0.175" z="0.030"/>
  </link>
  <joint name="zed_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="zed_camera_link"/>
    <origin xyz="0.270 -0.005 0.155" rpy="0 0 0"/>
  </joint>

  <!-- Camera optical frame: rotate camera frame → ROS optical convention -->
  <!-- (x=right, y=down, z=forward in optical vs x=forward, y=left, z=up in body) -->
  <link name="zed_camera_optical_frame"/>
  <joint name="zed_optical_joint" type="fixed">
    <parent link="zed_camera_link"/>
    <child  link="zed_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- Gazebo depth camera plugin — simulates RGB + depth (like ZED 2i).
       Uses libgazebo_ros_camera.so (the only RGBD plugin in ros-humble-gazebo-plugins).
       Sensor type="depth" causes the plugin to publish both image_raw and depth/image_raw.
       HFOV=1.9199 rad (110°) matches ZED 2i wide mode.                             -->
  <gazebo reference="zed_camera_link">
    <sensor name="zed_depth_camera" type="depth">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>false</visualize>
      <camera name="zed_depth_camera">
        <horizontal_fov>1.9199</horizontal_fov>
        <image>
          <width>640</width>
          <height>360</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.2</near>
          <far>20.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.003</stddev>
        </noise>
      </camera>
      <plugin name="zed_camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <!-- Publish into /zed/zed_node/ namespace, remapping to ZED SDK topic names -->
          <namespace>/zed/zed_node</namespace>
          <remapping>zed_depth_camera/image_raw:=rgb/image_rect_color</remapping>
          <remapping>zed_depth_camera/depth/image_raw:=depth/depth_registered</remapping>
          <remapping>zed_depth_camera/camera_info:=rgb/camera_info</remapping>
          <remapping>zed_depth_camera/points:=point_cloud/cloud_registered</remapping>
        </ros>
        <camera_name>zed_depth_camera</camera_name>
        <frame_name>zed_camera_optical_frame</frame_name>
        <hack_baseline>0.12</hack_baseline>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ── Differential drive plugin ─────────────────────────────────── -->
  <!-- Subscribes to /cmd_vel (Twist). An ackermann_to_twist node      -->
  <!-- converts /ego_racecar/drive → /cmd_vel for teleop compatibility. -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <remapping>cmd_vel:=/cmd_vel</remapping>
        <remapping>odom:=/ego_racecar/odom</remapping>
      </ros>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.232</wheel_separation>
      <wheel_diameter>0.10</wheel_diameter>
      <max_wheel_torque>5.0</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- ── Chassis material / friction ───────────────────────────────── -->
  <gazebo reference="base_link">
    <material>Gazebo/White</material>
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
  </gazebo>
  <gazebo reference="rear_left_wheel">
    <material>Gazebo/Black</material>
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
  </gazebo>
  <gazebo reference="rear_right_wheel">
    <material>Gazebo/Black</material>
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
  </gazebo>
  <gazebo reference="front_left_wheel">
    <material>Gazebo/Black</material>
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
  </gazebo>
  <gazebo reference="front_right_wheel">
    <material>Gazebo/Black</material>
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
  </gazebo>

</robot>
